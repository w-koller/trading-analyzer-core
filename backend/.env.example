# --- Moomoo / OpenD (co-located in this LXC, localhost only) ---
OPEND_HOST=127.0.0.1
OPEND_PORT=11111

# --- Ollama (separate LXC on the LAN) ---
OLLAMA_BASE_URL=http://192.168.68.49:11434/v1
OLLAMA_MODEL=deepseek-r1:32b

# --- Database ---
TRADING_DB_PATH=/opt/trading-analyzer/core/backend/data/trading.db

# --- Scanner ---
SCAN_INTERVAL_SECONDS=60

# --- News RSS sources ---

# --- App ---
LOG_LEVEL=INFO

# --- API ---
# The backend is NOT LAN-exposed. The browser reaches it at /api on the Next.js
# origin, which proxies to here over loopback — one origin, so no CORS and no
# mixed-content block on the public HTTPS deployment. Binding 0.0.0.0 here
# undoes that and re-opens :8000 to the whole LAN.
API_HOST=127.0.0.1
API_PORT=8000

# Only consulted for direct cross-origin callers, which the dashboard is not
# (it is same-origin through the proxy). Left empty on the normal deployment.
CORS_ORIGINS=

# Minutes before each market open to start the full-watchlist scan.
PREMARKET_LEAD_MINUTES=45

# Shared secret accepted in the X-API-Key header, FOR SCRIPTS ONLY.
# The dashboard does not use it — it authenticates with the ta_session cookie
# (see the auth block below). Do NOT put this in any NEXT_PUBLIC_* variable:
# it was, and it was compiled into the public JS bundle where anyone who could
# load the page could read it.
# Generate with: head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 40
API_TOKEN=

# --- Login (required: the dashboard is CLOSED until this is set) -----------
# Both are written by:  .venv/bin/python scripts/set_password.py
# Until then POST /auth/login returns 503 and every other route returns 401 —
# the dashboard is shut, not open. Restart the backend after running it.
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=

AUTH_COOKIE_NAME=ta_session
AUTH_SESSION_DAYS=30
# HTTPS-only cookie. Set false ONLY to test over plain http on the LAN — a
# Secure cookie is silently discarded there, so login appears to succeed and
# then bounces straight back, looking exactly like a wrong password.
AUTH_COOKIE_SECURE=true
# Per-IP brute-force limit. Meaningful only because the reverse proxy
# overwrites X-Forwarded-For; see deploy/nftables/trading.nft.
AUTH_MAX_LOGIN_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15

# --- Web Push (optional; the toggle reports "unconfigured" when unset) -----
# Generate the pair with:  .venv/bin/python scripts/generate_vapid.py
# The public key is served by GET /push/status at runtime and deliberately not
# baked into the frontend bundle, so rotating keys needs no rebuild.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

PUSH_CHECK_MINUTES=5
# Lowest alert severity worth waking a phone for: info | warn | critical
PUSH_MIN_SEVERITY=warn
PUSH_MAX_FAILURES=5
PUSH_RETENTION_DAYS=30

# News. Feeds themselves live in app/services/news_feeds.py.
# SEC EDGAR rejects requests without a User-Agent carrying contact
# details, so its feed is skipped until this is set.
NEWS_CONTACT_EMAIL=
NEWS_REFRESH_MINUTES=15
NEWS_RETENTION_DAYS=30
# Comma-separated feed keys to skip, e.g. sec_8k,ft_global_economy
NEWS_FEEDS_DISABLED=
