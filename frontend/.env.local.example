# Where the browser reaches the backend API.
#
# LEAVE THIS UNSET (or "/api"). The dashboard now proxies the API through its
# own origin via app/api/[...path]/route.ts, which is what makes the public
# HTTPS deployment work at all: one origin means no CORS, no mixed-content
# block, and a session cookie that is actually sent.
#
# Setting an absolute URL here re-breaks all three, and silently — cookies are
# only sent same-origin, so every call starts returning 401 with no clue why.
# NEXT_PUBLIC_API_URL=/api

# Where the SERVER-side proxy forwards to. Not exposed to the browser.
# The backend binds 127.0.0.1 now; nothing outside this box should reach :8000.
BACKEND_ORIGIN=http://127.0.0.1:8000

# The VAPID public key is deliberately NOT baked in here. The toggle reads it
# from GET /push/status at runtime instead, so rotating keys is a backend .env
# change plus a restart — no frontend rebuild, and no chance of a stale key
# compiled into the bundle silently producing unroutable subscriptions.

# The dashboard's real https address. Shown on the login page when it is opened
# over plain http — a Secure session cookie is discarded by the browser there,
# so login would appear to succeed and then bounce straight back.
NEXT_PUBLIC_CANONICAL_URL=https://your-host.example.com
